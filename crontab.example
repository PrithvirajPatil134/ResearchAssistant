# ResearchAssistant — Recommended Cron Schedule
#
# Install with: crontab crontab.example
# Or merge into existing crontab: crontab -l | cat - crontab.example | crontab -
#
# All scripts are idempotent and safe to re-run manually.
# All scripts exit 0 on success, non-zero with stderr on failure.
#
# Prerequisites:
#   - jq installed (brew install jq) — required by ra-weekly-status.sh
#   - Workspace at /Users/propatil/workplace/ResearchAssistant

# Weekly: Sunday 09:00 — Status report (includes lint + manifest + learner checks)
0 9 * * 0 cd /Users/propatil/workplace/ResearchAssistant && bash scripts/ra-weekly-status.sh

# Weekly: Sunday 09:15 — Wiki lint (standalone report to logs)
15 9 * * 0 cd /Users/propatil/workplace/ResearchAssistant && bash scripts/ra-wiki-lint.sh > data/logs/wiki-lint-$(date +\%Y-\%m-\%d).md 2>&1

# Weekly: Sunday 09:30 — Archive learner runs older than 7 days
30 9 * * 0 cd /Users/propatil/workplace/ResearchAssistant && bash scripts/learner-archive.sh

# Weekly: Sunday 09:35 — Manifest cleanup (move stale ingest manifests to archive)
35 9 * * 0 cd /Users/propatil/workplace/ResearchAssistant && bash scripts/ra-manifest-cleanup.sh

# Weekly: Sunday 09:45 — Scratchpad archive, orphan image scan, ingest cleanup
45 9 * * 0 cd /Users/propatil/workplace/ResearchAssistant && bash scripts/scratchpad-archive.sh && bash scripts/image-orphan-scan.sh && bash scripts/ingest-cleanup.sh

# Weekly: Sunday 09:50 — Rebuild wiki _index.md from actual pages (uses project venv)
50 9 * * 0 cd /Users/propatil/workplace/ResearchAssistant && .venv/bin/python3 scripts/rebuild-wiki-index.py --all --date "$(date +\%Y-\%m-\%d)" > data/logs/index-rebuild-$(date +\%Y-\%m-\%d).log 2>&1

# Weekly: Sunday 09:55 — Storage audit (size report + growth warnings)
55 9 * * 0 cd /Users/propatil/workplace/ResearchAssistant && bash scripts/ra-storage-audit.sh > data/logs/storage-audit-$(date +\%Y-\%m-\%d).log 2>&1

# Monthly: 1st of month 03:00 — Learner monthly summary
0 3 1 * * cd /Users/propatil/workplace/ResearchAssistant && bash scripts/learner-summarize-month.sh
