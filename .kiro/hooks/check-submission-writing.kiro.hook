{
  "enabled": true,
  "name": "Check Submission Writing Style",
  "description": "When a submission-ready academic file is created or edited (homework submissions, research papers, literature reviews, teaching notes, case studies in workspace folders), scans the content against the human-authored-writing steering rule for banned words, phrases, openers, and structural violations.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/workspace/**/*.md",
      "**/output/**/*.md",
      "**/assignment/**/*.md",
      "**/literature review/**/*Submission*.md",
      "**/literature review/**/*Paper*.md",
      "**/output/**/*Submission*.md",
      "**/output/**/*Paper*.md",
      "**/output/**/*Teaching*.md",
      "**/output/**/*Case*.md",
      "**/workspace/**/*revised*.md",
      "**/workspace/**/*Teaching*.md",
      "**/workspace/**/*Case*.md",
      "**/assignment/**/*Submission*.md",
      "**/assignment/**/*Paper*.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "The file just edited is submission-ready academic content. You MUST scan it against .kiro/steering/human-authored-writing.md. Run a check for: (1) banned words (delve, tapestry, nuanced, landscape, multifaceted, leverage, utilize, streamline, foster, facilitate, harness, robust, seamless, scalable, comprehensive, pivotal, groundbreaking, transformative, revolutionary, game-changing, cutting-edge, remarkable, crucial, significant, aforementioned, underscores, underpin, elucidate, myriad, plethora, paradigm), (2) banned phrases, (3) banned sentence openers (Furthermore, Moreover, Additionally, Consequently, Subsequently, Nevertheless, In conclusion, To sum up), (4) uniform sentence rhythm (5+ consecutive sentences within 5 words of each other), (5) narrator voice instead of author voice, (6) announcing structure patterns (This section will discuss...), (7) em dash ban: search for the em dash character, there must be ZERO em dashes, this is a zero-tolerance rule, replace all with periods and new sentences, commas, colons, semicolons, or parentheses. (8) Academic tone: flag and rewrite any casual, conversational, or colloquial language. Avoid informal phrasing such as 'works like this', 'here is the problem', 'the cycle feeds itself', 'the takeaway', 'that said', 'at the end of the day'. Use formal academic register throughout: prefer 'the analysis demonstrates' over 'this shows', 'it is evident that' over 'clearly', 'the preceding analysis indicates' over 'the takeaway'. Maintain third-person perspective and impersonal constructions where appropriate. If ANY violation is found, fix it immediately."
  }
}